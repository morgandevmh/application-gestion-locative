# Base de données PostgreSQL
# Local : postgresql://UTILISATEUR:MOTDEPASSE@localhost:5432/gestion_locative
# Production : adresse poolée Neon, avec sslmode=verify-full
DATABASE_URL=

# Better Auth
# Secret d'au moins 32 caractères : openssl rand -base64 32
# Un secret différent par environnement
BETTER_AUTH_SECRET=
# URL publique de l'application (http://localhost:3000 en local)
BETTER_AUTH_URL=

# Cloudflare R2
# "eu" si le bucket est en juridiction européenne (production), sinon laisser vide
R2_JURISDICTION=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=